# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wanli_dev
DB_USERNAME=root
DB_PASSWORD=dev_password

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT配置
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=86400

# 邮件配置
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# 文件上传配置
FILE_UPLOAD_PATH=/tmp/uploads
MAX_FILE_SIZE=10MB

# 日志配置
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/wanli-backend.log

# 应用配置
APP_NAME=万里后端管理系统
APP_VERSION=1.0.0
APP_DESCRIPTION=万里后端管理系统API服务
